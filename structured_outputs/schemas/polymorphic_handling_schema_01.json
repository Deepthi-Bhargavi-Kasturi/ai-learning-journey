{
    "type": "object",
    "required": [
        "company_name",
        "reporting_year",
        "total_emissions_tco2e",
        "reporting_status",
        "sites"
    ],
    "properties": {
        "company_name": {
            "type": "string"
        },
        "reporting_year": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2100
        },
        "total_emissions_tco2e": {
            "type": "number",
            "minimum": 0
        },
        "renewable_energy_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
        },
        "reporting_status": {
            "type": "string",
            "enum": [
                "draft",
                "reviewed",
                "published"
            ]
        },
        "is_third_party_verified": {
            "type": "boolean"
        },
        "sites": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
                "type": "object",
                "required": [
                    "site_name",
                    "country",
                    "annual_energy_kwh"
                ],
                "properties": {
                    "site_name": {
                        "type": "string"
                    },
                    "country": {
                        "type": "string"
                    },
                    "annual_energy_kwh": {
                        "type": "number",
                        "minimum": 0
                    }
                }
            }
        },
        "emissions_source": {
            "oneOf": [
                {
                    "type": "object",
                    "required": [
                        "kind",
                        "product_name",
                        "embodied_carbon_kg"
                    ],
                    "properties": {
                        "kind": {
                            "type": "string",
                            "enum": [
                                "product"
                            ]
                        },
                        "product_name": {
                            "type": "string"
                        },
                        "embodied_carbon_kg": {
                            "type": "number",
                            "minimum": 0
                        }
                    }
                },
                {
                    "type": "object",
                    "required": [
                        "kind",
                        "service_name",
                        "service_hours"
                    ],
                    "properties": {
                        "kind": {
                            "type": "string",
                            "enum": [
                                "service"
                            ]
                        },
                        "service_name": {
                            "type": "string"
                        },
                        "service_hours": {
                            "type": "number",
                            "minimum": 0
                        }
                    }
                }
            ]
        },
        "evidence": {
            "anyOf": [
                {
                    "type": "string",
                    "pattern": "^https://"
                },
                {
                    "type": "object",
                    "required": [
                        "document_id",
                        "page"
                    ],
                    "properties": {
                        "document_id": {
                            "type": "string"
                        },
                        "page": {
                            "type": "integer",
                            "minimum": 1
                        }
                    }
                }
            ]
        },
        "verified_metric": {
        "allOf": [
            {
                "type": "object",
                "required": [
                    "metric_name",
                    "value_tco2e"
                ],
                "properties": {
                    "metric_name": {
                        "type": "string"
                    },
                    "value_tco2e": {
                        "type": "number",
                        "minimum": 0
                    }
                }
            },
            {
                "type": "object",
                "required": [
                    "verification_status"
                ],
                "properties": {
                    "verification_status": {
                        "type": "string",
                        "enum": [
                            "verified"
                        ]
                    }
                }
            }
        ]
        }
    }
}
